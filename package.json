{
  "name": "gem-crush",
  "version": "1.1.0",
  "description": "A modern Match-3 puzzle game built with TypeScript, Canvas API, and Web Audio API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "match-3",
    "puzzle",
    "game",
    "typescript",
    "canvas",
    "web-audio"
  ],
  "author": "Sergey Butov <butovx@gmail.com>",
  "homepage": "https://butovx.github.io/gem-crush/",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
